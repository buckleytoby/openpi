Bootstrap: docker
From: ghcr.io/astral-sh/uv:0.5.1
Stage: uv

Bootstrap: docker
From: nvidia/cuda:12.2.2-cudnn8-runtime-ubuntu22.04
Stage: final

%files from uv
    /uv /bin/uv
    /uvx /bin/uvx

%files
    pyproject.toml /app/pyproject.toml
    uv.lock /app/uv.lock
    packages/openpi-client/pyproject.toml /app/packages/openpi-client/pyproject.toml
    packages/openpi-client/src /app/packages/openpi-client/src

%post
    apt-get update && apt-get install -y git git-lfs linux-headers-generic build-essential clang
    export UV_LINK_MODE=copy
    export UV_PROJECT_ENVIRONMENT=/.venv
    cd /app
    uv venv --python 3.11.9 $UV_PROJECT_ENVIRONMENT
    GIT_LFS_SKIP_SMUDGE=1 uv sync --frozen --no-install-project --no-dev
    # NOTE: unlike the Dockerfile, the transformers_replace patch is NOT applied at build
    # time here -- copying the repo's src/ directory into the image via %files/%setup was
    # unreliable in this multi-stage build. Since the repo is bind-mounted at /app at
    # runtime anyway, apply the patch then instead (see scripts/docker/apply_transformers_patch.sh).

%environment
    export UV_LINK_MODE=copy
    export UV_PROJECT_ENVIRONMENT=/.venv
    export PATH=/.venv/bin:/bin:$PATH

%runscript
    cd /app && uv run scripts/serve_policy.py "$@"
